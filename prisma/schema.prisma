// /prisma/schema.prisma

// Generador de Prisma 7: el cliente se genera como código TypeScript dentro de
// src/generated/prisma (ignorado por git) y se importa desde ahí.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Convención de tipos numéricos:
// - Montos de dinero: Decimal(14, 2)  -> hasta 999.999.999.999,99 sin errores de redondeo
// - Cantidades:       Decimal(14, 3)  -> admite fracciones como 2,5 m o 0,125 kg

// ==========================================
// 1. AUTENTICACIÓN Y ROLES
// ==========================================
model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // Ej: "Administrador", "Bodeguero", "Ventas"
  users User[]

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String // Aquí guardaremos la contraseña encriptada (hash)
  roleId   Int
  role     Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)

  @@index([roleId])
}

// ==========================================
// 2. CONFIGURACIÓN DE MATERIALES
// ==========================================
model UnitMeasure {
  productionConsumptions ProductionConsumption[]
  productionOutputs      ProductionOutput[]

  reservations         StockReservationAllocation[]
  id                   Int                          @id @default(autoincrement())
  name                 String                       @unique // Ej: "Kilos", "Unidades", "Metros"
  abbreviation         String // Ej: "kg", "un", "m"
  quoteDetails         QuoteDetail[]
  materials            RawMaterial[]
  products             Product[]
  productInitialStocks ProductInitialStock[]
  productAdjustments   ProductInventoryAdjustment[]
  workOrderLines       WorkOrderLine[]
  workOrderRecipes     WorkOrderRecipeMaterial[]
  workOrderMaterials   WorkOrderDetail[]

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)
}

// Cada material se maneja siempre en UNA sola unidad (la de unitMeasure).
// Stock, movimientos y consumos usan esa unidad; las compras conservan además su presentación comercial.
model RawMaterial {
  productionConsumptions ProductionConsumption[]

  reservations  StockReservationAllocation[]
  id            Int                          @id @default(autoincrement())
  code          String                       @unique
  name          String
  description   String?
  unitMeasureId Int
  unitMeasure   UnitMeasure                  @relation(fields: [unitMeasureId], references: [id])

  inventoryTransfers   InventoryTransfer[]
  inventoryAdjustments InventoryAdjustment[]
  stocks               WarehouseStock[]
  stockMovements       StockMovement[]
  purchases            PurchaseDetail[]
  workOrders           WorkOrderDetail[]
  quoteDetails         QuoteDetail[]
  productRecipes       ProductRecipe[]
  workOrderLines       WorkOrderLine[]
  workOrderRecipes     WorkOrderRecipeMaterial[]
  workOrderSupplies    WorkOrderSupplyPlan[]

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)

  @@index([unitMeasureId])
}

// ==========================================
// 3. BODEGA Y STOCK
// ==========================================
enum WarehouseClassification {
  MATERIA_PRIMA
  PRODUCTO_TERMINADO
  MIXTA
}

model Warehouse {
  productionConsumptions ProductionConsumption[]
  productionOutputs      ProductionOutput[]

  reservations         StockReservationAllocation[]
  // Sin default: conservar bodegas anteriores sin asignarles una clasificación ficticia.
  classification       WarehouseClassification?
  productStocks        ProductWarehouseStock[]
  productMovements     ProductStockMovement[]
  productInitialStocks ProductInitialStock[]
  productAdjustments   ProductInventoryAdjustment[]
  outgoingTransfers    InventoryTransfer[]          @relation("BodegaOrigen")
  incomingTransfers    InventoryTransfer[]          @relation("BodegaDestino")
  id                   Int                          @id @default(autoincrement())
  name                 String
  location             String?
  inventoryAdjustments InventoryAdjustment[]
  stocks               WarehouseStock[]
  stockMovements       StockMovement[]
  purchaseDetails      PurchaseDetail[]
  purchases            Purchase[]
  workOrderDetails     WorkOrderDetail[]
  workOrderSupplies    WorkOrderSupplyPlan[]

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)
}

// Saldo actual de un material en una bodega (en la unidad del material).
// Debe coincidir siempre con la suma de sus StockMovement.
model WarehouseStock {
  id            Int      @id @default(autoincrement())
  quantity      Decimal  @default(0) @db.Decimal(14, 3)
  // Mínimo de reposición en la unidad del material; null significa sin configurar.
  // La migración SQL exige un valor no negativo y distinto de NaN mediante CHECK.
  minStock      Decimal? @db.Decimal(14, 3)
  warehouseId   Int
  rawMaterialId Int

  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  // Evita que un mismo material esté duplicado en la misma bodega.
  // También sirve como índice para buscar por bodega.

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)

  @@unique([warehouseId, rawMaterialId])
  @@index([rawMaterialId])
}

// Historial (kardex) de cada entrada, salida o ajuste de stock.
// quantity lleva signo: positivo suma al stock, negativo descuenta.
model StockMovement {
  productionReversalConsumptionId Int?                           @unique
  productionReversalConsumption   ProductionReversalConsumption? @relation(fields: [productionReversalConsumptionId, rawMaterialId, warehouseId], references: [id, rawMaterialId, warehouseId], onDelete: Restrict)
  productionConsumptionId         Int?                           @unique
  productionConsumption           ProductionConsumption?         @relation(fields: [productionConsumptionId, rawMaterialId, warehouseId], references: [id, rawMaterialId, warehouseId], onDelete: Restrict)

  id                      Int                  @id @default(autoincrement())
  date                    DateTime             @default(now())
  type                    StockMovementType
  quantity                Decimal              @db.Decimal(14, 3)
  note                    String? // Motivo, sobre todo en los ajustes
  warehouseId             Int
  rawMaterialId           Int
  // Origen persistido; los movimientos antiguos pueden no tener documento asociado.
  outgoingTransferId      Int?                 @unique
  incomingTransferId      Int?                 @unique
  outgoingTransfer        InventoryTransfer?   @relation("SalidaTraslado", fields: [outgoingTransferId, warehouseId, rawMaterialId], references: [id, sourceWarehouseId, rawMaterialId], onDelete: Restrict)
  incomingTransfer        InventoryTransfer?   @relation("EntradaTraslado", fields: [incomingTransferId, warehouseId, rawMaterialId], references: [id, destinationWarehouseId, rawMaterialId], onDelete: Restrict)
  inventoryAdjustmentId   Int?                 @unique
  inventoryAdjustment     InventoryAdjustment? @relation(fields: [inventoryAdjustmentId, warehouseId, rawMaterialId], references: [id, warehouseId, rawMaterialId], onDelete: Restrict)
  purchaseDetailId        Int?
  workOrderDetailId       Int?
  purchaseReceiptDetailId Int?                 @unique
  reversedReceiptDetailId Int?                 @unique

  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  rawMaterial     RawMaterial      @relation(fields: [rawMaterialId], references: [id])
  purchaseDetail  PurchaseDetail?  @relation(fields: [purchaseDetailId], references: [id])
  workOrderDetail WorkOrderDetail? @relation(fields: [workOrderDetailId], references: [id])

  purchaseReceiptDetail PurchaseReceiptDetail? @relation("EntradaRecepcion", fields: [purchaseReceiptDetailId], references: [id], onDelete: Restrict)
  reversedReceiptDetail PurchaseReceiptDetail? @relation("ReversionRecepcion", fields: [reversedReceiptDetailId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)

  @@unique([outgoingTransferId, warehouseId, rawMaterialId])
  @@unique([incomingTransferId, warehouseId, rawMaterialId])
  @@unique([inventoryAdjustmentId, warehouseId, rawMaterialId])
  @@unique([productionReversalConsumptionId, rawMaterialId, warehouseId])
  @@unique([productionConsumptionId, rawMaterialId, warehouseId])
  @@index([warehouseId, rawMaterialId, date])
  @@index([rawMaterialId])
  @@index([purchaseDetailId])
  @@index([workOrderDetailId])
}

// Motivos internos fijos: etiquetas visibles centralizadas en el cliente.
enum InventoryAdjustmentReason {
  CONTEO_FISICO
  MERMA_PERDIDA
  DETERIORO_DANO
  CORRECCION_REGISTRO
  OTRO
  INVENTARIO_INICIAL
}

enum InventoryOperationType {
  TRASLADAR
  REVERTIR_TRASLADO
  AJUSTAR
  CARGAR_INICIAL
  CORREGIR
}

// Documento histórico inmutable. Los saldos son evidencia del conteo, no otro saldo vigente.
model InventoryAdjustment {
  id                    Int                       @id @default(autoincrement())
  date                  DateTime                  @db.Date
  reason                InventoryAdjustmentReason
  note                  String
  previousQuantity      Decimal                   @db.Decimal(14, 3)
  finalQuantity         Decimal                   @db.Decimal(14, 3)
  difference            Decimal                   @db.Decimal(14, 3)
  warehouseId           Int
  rawMaterialId         Int
  correctedAdjustmentId Int?
  warehouse             Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  rawMaterial           RawMaterial               @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  correctedAdjustment   InventoryAdjustment?      @relation("CorreccionInventario", fields: [correctedAdjustmentId, warehouseId, rawMaterialId], references: [id, warehouseId, rawMaterialId], onDelete: Restrict)
  corrections           InventoryAdjustment[]     @relation("CorreccionInventario")
  movement              StockMovement?
  operation             InventoryOperation?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([id, warehouseId, rawMaterialId])
  @@index([warehouseId, rawMaterialId, date])
  @@index([rawMaterialId])
  @@index([correctedAdjustmentId, warehouseId, rawMaterialId])
  @@index([date, id])
}

// UUID estable y huella del contenido: se guarda junto con sus efectos en la misma transacción.
// Independiente de PurchaseOperation; exactamente un ajuste o traslado por operación (CHECK SQL).
model InventoryOperation {
  transferId     Int?                   @unique
  transfer       InventoryTransfer?     @relation(fields: [transferId], references: [id], onDelete: Restrict)
  idempotencyKey String                 @id @db.Uuid
  type           InventoryOperationType
  requestHash    String                 @db.Char(64)
  adjustmentId   Int?                   @unique
  adjustment     InventoryAdjustment?   @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

// Traslado inmediato de un material. Los saldos conservan la evidencia previa/final de ambas bodegas.
// Corregir registra un traslado inverso completo, vinculado; nunca modifica este documento.
model InventoryTransfer {
  id                          Int                 @id @default(autoincrement())
  date                        DateTime            @db.Date
  note                        String
  quantity                    Decimal             @db.Decimal(14, 3)
  sourcePreviousQuantity      Decimal             @db.Decimal(14, 3)
  sourceFinalQuantity         Decimal             @db.Decimal(14, 3)
  destinationPreviousQuantity Decimal             @db.Decimal(14, 3)
  destinationFinalQuantity    Decimal             @db.Decimal(14, 3)
  rawMaterialId               Int
  sourceWarehouseId           Int
  destinationWarehouseId      Int
  correctedTransferId         Int?                @unique
  rawMaterial                 RawMaterial         @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  sourceWarehouse             Warehouse           @relation("BodegaOrigen", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse        Warehouse           @relation("BodegaDestino", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  correctedTransfer           InventoryTransfer?  @relation("CorreccionTraslado", fields: [correctedTransferId], references: [id], onDelete: Restrict)
  correction                  InventoryTransfer?  @relation("CorreccionTraslado")
  outgoingMovement            StockMovement?      @relation("SalidaTraslado")
  incomingMovement            StockMovement?      @relation("EntradaTraslado")
  operation                   InventoryOperation?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  @@unique([id, sourceWarehouseId, rawMaterialId])
  @@unique([id, destinationWarehouseId, rawMaterialId])
  @@index([rawMaterialId, date])
  @@index([sourceWarehouseId, date])
  @@index([destinationWarehouseId, date])
  @@index([date, id])
}

enum StockMovementType {
  ENTRADA // Compra recibida
  SALIDA // Consumo de una orden de trabajo
  AJUSTE // Corrección manual (inventario, merma, pérdida)
}

// ==========================================
// 4. PROVEEDORES Y COMPRAS
// ==========================================
model Supplier {
  id        Int        @id @default(autoincrement())
  rut       String     @unique // Identificador fiscal
  name      String
  email     String?
  phone     String?
  purchases Purchase[]

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)
}

// Catálogo de identificación del documento de compra; sin tipos ficticios iniciales.
model DocumentType {
  id        Int        @id @default(autoincrement())
  code      String     @unique @db.VarChar(50)
  name      String     @unique @db.VarChar(100)
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Purchase {
  id                       Int                 @id @default(autoincrement())
  date                     DateTime            @default(now())
  totalAmount              Decimal             @db.Decimal(14, 2)
  supplierId               Int
  supplierRut              String              @db.VarChar(12) // Identidad histórica; no cambia al editar el proveedor.
  documentTypeId           Int
  documentTypeCode         String              @db.VarChar(50) // Código histórico del tipo.
  documentNumber           String              @db.VarChar(100) // Texto; conserva ceros iniciales.
  documentNumberNormalized String              @db.VarChar(100) // Trim y mayúsculas, sin quitar ceros.
  warehouseId              Int // Bodega única para líneas y recepciones.
  version                  Int                 @default(1)
  voidedAt                 DateTime?
  voidReason               String?
  deletedAt                DateTime? // Eliminación lógica sólo después de anular; conserva origen en Kardex.
  supplier                 Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  documentType             DocumentType        @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  warehouse                Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  details                  PurchaseDetail[]
  receipts                 PurchaseReceipt[]
  operations               PurchaseOperation[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([supplierRut, documentTypeId, documentNumberNormalized])
  @@unique([supplierId, documentTypeId, documentNumberNormalized])
  @@unique([id, warehouseId])
  @@index([documentTypeId])
  @@index([warehouseId])
  @@index([deletedAt, date])
}

model PurchaseDetail {
  id                Int                      @id @default(autoincrement())
  quantity          Decimal                  @db.Decimal(14, 3) // Total comprado en unidad de inventario; conserva significado previo.
  purchasedQuantity Decimal                  @db.Decimal(14, 3) // Cantidad de presentaciones compradas.
  presentation      String                   @db.VarChar(100)
  unitFactor        Decimal                  @db.Decimal(14, 3) // Contenido por presentación en unidad del material.
  unitPrice         Decimal                  @db.Decimal(14, 2) // Precio por presentación; inmutable desde INSERT mediante trigger SQL.
  lineAmount        Decimal                  @db.Decimal(14, 2) // ROUND(purchasedQuantity * unitPrice, 2).
  purchaseId        Int
  rawMaterialId     Int
  warehouseId       Int // Debe coincidir con cabecera; FK compuesta.
  purchase          Purchase                 @relation(fields: [purchaseId, warehouseId], references: [id, warehouseId], onDelete: Restrict)
  rawMaterial       RawMaterial              @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  warehouse         Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stockMovements    StockMovement[]
  receiptDetails    PurchaseReceiptDetail[]
  closures          PurchasePendingClosure[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([id, purchaseId])
  @@index([purchaseId, warehouseId])
  @@index([rawMaterialId])
  @@index([warehouseId])
}

// El saldo pendiente/estado de recepción se deriva, no se guarda duplicado.
model PurchaseReceipt {
  id         Int                     @id @default(autoincrement())
  purchaseId Int
  date       DateTime                @default(now())
  note       String?
  purchase   Purchase                @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  details    PurchaseReceiptDetail[]
  operation  PurchaseOperation?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([id, purchaseId])
  @@index([purchaseId, date])
}

model PurchaseReceiptDetail {
  id                Int             @id @default(autoincrement())
  purchaseId        Int // Las dos FK compuestas impiden mezclar compras.
  receiptId         Int
  purchaseDetailId  Int
  receivedQuantity  Decimal         @db.Decimal(14, 3) // Presentaciones recibidas; se admiten fracciones exactas.
  inventoryQuantity Decimal         @db.Decimal(14, 3) // Equivalente exacto; validar con factor histórico bajo bloqueo.
  receipt           PurchaseReceipt @relation(fields: [receiptId, purchaseId], references: [id, purchaseId], onDelete: Restrict)
  purchaseDetail    PurchaseDetail  @relation(fields: [purchaseDetailId, purchaseId], references: [id, purchaseId], onDelete: Restrict)
  entryMovement     StockMovement?  @relation("EntradaRecepcion")
  reversalMovement  StockMovement?  @relation("ReversionRecepcion")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([receiptId, purchaseDetailId])
  @@index([receiptId, purchaseId])
  @@index([purchaseDetailId, purchaseId])
}

model PurchasePendingClosure {
  purchaseId       Int
  id               Int                @id @default(autoincrement())
  purchaseDetailId Int
  quantity         Decimal            @db.Decimal(14, 3) // Pendiente cerrado en presentaciones; no modifica lo comprado.
  reason           String
  purchaseDetail   PurchaseDetail     @relation(fields: [purchaseDetailId, purchaseId], references: [id, purchaseId], onDelete: Restrict)
  operation        PurchaseOperation?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([id, purchaseId])
  @@index([purchaseDetailId, purchaseId])
}

enum PurchaseOperationType {
  CREAR
  RECIBIR
  CERRAR_PENDIENTE
  ANULAR
  ELIMINAR
}

// Registrar junto con los efectos, en la misma transacción; sin generar una clave nueva al reintentar.
model PurchaseOperation {
  idempotencyKey String                  @id @db.Uuid
  type           PurchaseOperationType
  requestHash    String                  @db.Char(64)
  purchaseId     Int
  receiptId      Int?                    @unique
  closureId      Int?                    @unique
  purchase       Purchase                @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  receipt        PurchaseReceipt?        @relation(fields: [receiptId, purchaseId], references: [id, purchaseId], onDelete: Restrict)
  closure        PurchasePendingClosure? @relation(fields: [closureId, purchaseId], references: [id, purchaseId], onDelete: Restrict)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([receiptId, purchaseId])
  @@unique([closureId, purchaseId])
  @@index([purchaseId, type])
}

// ==========================================
// 5. CLIENTES Y VENTAS
// ==========================================
model Client {
  id          Int            @id @default(autoincrement())
  rut         String         @unique
  name        String
  contact     String?
  email       String?
  phone       String?
  quotes      Quote[]
  salesOrders SalesOrder[]
  branches    ClientBranch[]

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)
}

// Sucursal comercial del cliente. Sólo la migración conserva datos heredados incompletos.
model ClientBranch {
  id               Int          @id @default(autoincrement())
  clientId         Int
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  isHeadOffice     Boolean      @default(false)
  legacyIncomplete Boolean      @default(false)
  address          String?
  city             String?
  contact          String?
  phone            String?
  email            String?
  quotes           Quote[]
  salesOrders      SalesOrder[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([id, clientId])
  @@index([clientId])
}

// Catálogo comercial: el plazo se copia al documento al seleccionar la condición.
model PaymentCondition {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  days        Int
  version     Int          @default(1)
  quotes      Quote[]
  salesOrders SalesOrder[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Quote {
  // Nullable sólo para compatibilidad con documentos previos; el nuevo servicio
  // exige folio, identidad, copias e importes completos en el primer guardado.
  folioId              Int?                @unique
  folio                DocumentFolio?      @relation(fields: [folioId], references: [id], onDelete: Restrict)
  creationKey          String?             @unique @db.Uuid
  version              Int                 @default(1)
  clientName           String?
  clientRut            String?
  clientContact        String?
  clientPhone          String?
  clientEmail          String?
  companySnapshot      Json?
  commercialTerms      String?
  pdfEmissions         QuotePdfEmission[]
  technicalDescription Json?
  subtotal             Decimal?            @db.Decimal(14, 2)
  discountMode         QuoteDiscountMode   @default(SIN_DESCUENTO)
  discountValue        Decimal?            @db.Decimal(14, 2)
  discountAmount       Decimal?            @db.Decimal(14, 2)
  netAmount            Decimal?            @db.Decimal(14, 2)
  vatAmount            Decimal?            @db.Decimal(14, 2)
  deletedAt            DateTime?
  correctedQuoteId     Int?
  correctedQuote       Quote?              @relation("QuoteCorrections", fields: [correctedQuoteId], references: [id], onDelete: Restrict)
  corrections          Quote[]             @relation("QuoteCorrections")
  operations           QuoteOperation[]
  imageLinks           QuoteImageLink[]
  vatRatePeriodId      Int?
  vatRatePeriod        VatRatePeriod?      @relation(fields: [vatRatePeriodId], references: [id], onDelete: Restrict)
  vatRate              Decimal?            @db.Decimal(7, 4)
  id                   Int                 @id @default(autoincrement())
  date                 DateTime            @default(now()) @db.Date
  validUntil           DateTime?           @db.Date // Fecha hasta la que se mantiene la oferta
  status               QuoteStatus         @default(PENDIENTE)
  totalAmount          Decimal             @db.Decimal(14, 2)
  clientId             Int
  client               Client              @relation(fields: [clientId], references: [id])
  details              QuoteDetail[]
  salesOrder           SalesOrder?
  paymentConditionId   Int?
  paymentCondition     PaymentCondition?   @relation(fields: [paymentConditionId], references: [id], onDelete: Restrict)
  paymentConditionName String? // Copia histórica; no se recalcula al editar el catálogo
  paymentTermDays      Int? // Plazo acordado, no vencimiento ni cuotas
  clientBranchId       Int?
  clientBranch         ClientBranch?       @relation(fields: [clientBranchId, clientId], references: [id, clientId], onDelete: Restrict)
  branchName           String?
  branchAddress        String?
  branchCity           String?
  branchContact        String?
  branchPhone          String?
  branchEmail          String?
  bankAccountId        Int?
  bankAccount          CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  bankName             String?
  bankAccountType      String?
  bankAccountNumber    String?
  bankHolderName       String?
  bankHolderRut        String?
  bankEmail            String?

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)

  @@index([clientId])
  @@index([paymentConditionId])
  @@index([correctedQuoteId])
  @@index([deletedAt, date, id])
  @@index([status, date, id])
  @@index([vatRatePeriodId])
  @@index([clientBranchId, clientId])
  @@index([bankAccountId])
}

// Línea de cotización: kind distingue materia prima, producto y servicio.
// Una referencia rawMaterialId nula no identifica por sí sola un servicio.
model QuoteDetail {
  salesOrderDetail        SalesOrderDetail?
  rawMaterialCode         String?
  position                Int?
  kind                    QuoteLineType?
  unitMeasureId           Int?
  unitMeasure             UnitMeasure?      @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  unitName                String?
  unitAbbreviation        String?
  lineAmount              Decimal?          @db.Decimal(14, 2)
  id                      Int               @id @default(autoincrement())
  description             String
  quantity                Decimal           @db.Decimal(14, 3)
  unitPrice               Decimal           @db.Decimal(14, 2)
  quoteId                 Int
  rawMaterialId           Int?
  productId               Int?
  product                 Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  productCode             String?           @db.Uuid
  productUnitName         String?
  productUnitAbbreviation String?
  quote                   Quote             @relation(fields: [quoteId], references: [id])
  rawMaterial             RawMaterial?      @relation(fields: [rawMaterialId], references: [id])

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)

  @@unique([quoteId, position])
  @@unique([id, quoteId])
  @@index([unitMeasureId])
  @@index([quoteId])
  @@index([rawMaterialId])
  @@index([productId])
}

enum QuoteStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model SalesOrder {
  // Opcionales sólo para conservar órdenes legadas; SQL exige documento completo al insertar.
  folioId               Int?                  @unique
  folio                 DocumentFolio?        @relation(fields: [folioId], references: [id], onDelete: Restrict)
  creationKey           String?               @unique @db.Uuid
  version               Int                   @default(1)
  status                SalesOrderStatus?
  acceptanceDate        DateTime?             @db.Date
  quoteVersion          Int?
  approvedQuoteVersion  Int?
  quoteSnapshot         Json?
  clientId              Int?
  client                Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientBranchId        Int?
  clientBranch          ClientBranch?         @relation(fields: [clientBranchId, clientId], references: [id, clientId], onDelete: Restrict)
  clientName            String?
  branchName            String?
  clientSnapshot        Json?
  companySnapshot       Json?
  paymentConditionId    Int?
  paymentCondition      PaymentCondition?     @relation(fields: [paymentConditionId], references: [id], onDelete: Restrict)
  paymentConditionName  String?
  paymentTermDays       Int?
  bankAccountId         Int?
  bankAccount           CompanyBankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  bankSnapshot          Json?
  commercialTerms       String?
  technicalDescription  Json?
  customerOrderNumber   String?               @db.VarChar(150)
  customerOrderKey      String?               @db.VarChar(150)
  customerOrderDate     DateTime?             @db.Date
  pdfEmissionId         String?               @db.Uuid
  pdfEmission           QuotePdfEmission?     @relation(fields: [pdfEmissionId], references: [id], onDelete: Restrict)
  subtotal              Decimal?              @db.Decimal(14, 2)
  offeredSubtotal       Decimal?              @db.Decimal(14, 2)
  offeredDiscountAmount Decimal?              @db.Decimal(14, 2)
  discountMode          QuoteDiscountMode?
  discountValue         Decimal?              @db.Decimal(14, 2)
  discountAmount        Decimal?              @db.Decimal(14, 2)
  vatRate               Decimal?              @db.Decimal(7, 4)
  netAmount             Decimal?              @db.Decimal(14, 2)
  vatAmount             Decimal?              @db.Decimal(14, 2)
  totalAmount           Decimal?              @db.Decimal(14, 2)
  voidedAt              DateTime?
  voidReason            String?
  details               SalesOrderDetail[]
  operations            SalesOrderOperation[]
  id                    Int                   @id @default(autoincrement())
  date                  DateTime              @default(now())
  quoteId               Int                   @unique
  pdfUrl                String? // URL del archivo almacenado (para cuando usemos AWS S3)
  quote                 Quote                 @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  workOrder             WorkOrder?
  accountReceivable     AccountReceivable? // Cuenta única creada al confirmar el registro comercial nuevo

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)

  // quoteId ya queda indexado por @unique; una anulación futura conserva el vínculo.
  @@unique([id, quoteId])
  @@unique([clientId, customerOrderKey])
  @@index([status, acceptanceDate, id])
  @@index([clientId, acceptanceDate, id])
  @@index([clientBranchId, clientId])
  @@index([paymentConditionId])
  @@index([bankAccountId])
  @@index([pdfEmissionId])
}

enum SalesOrderStatus {
  CONFIRMADA
  ANULADA
}

enum SalesOrderOperationType {
  CONFIRMAR
  ANULAR
}

model SalesOrderDetail {
  id               Int            @id @default(autoincrement())
  salesOrderId     Int
  quoteId          Int
  salesOrder       SalesOrder     @relation(fields: [salesOrderId, quoteId], references: [id, quoteId], onDelete: Restrict)
  quoteDetailId    Int            @unique
  quoteDetail      QuoteDetail    @relation(fields: [quoteDetailId, quoteId], references: [id, quoteId], onDelete: Restrict)
  position         Int
  kind             QuoteLineType
  description      String
  quantity         Decimal        @db.Decimal(14, 3)
  unitPrice        Decimal        @db.Decimal(14, 2)
  lineAmount       Decimal        @db.Decimal(14, 2)
  // IDs y unidad del origen quedan protegidos por la FK a la línea inmutable.
  rawMaterialId    Int?
  productId        Int?
  unitMeasureId    Int
  code             String?
  unitName         String
  unitAbbreviation String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  workOrderLine    WorkOrderLine?

  @@unique([id, salesOrderId])
  @@unique([salesOrderId, position])
  @@unique([quoteDetailId, quoteId])
  @@index([salesOrderId, quoteId])
}

model SalesOrderOperation {
  idempotencyKey String                  @id @db.Uuid
  fingerprint    String
  type           SalesOrderOperationType
  salesOrderId   Int
  salesOrder     SalesOrder              @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  version        Int
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([salesOrderId, version])
}

// ==========================================
// 6. PRODUCCIÓN Y ENTREGAS
// ==========================================

// Orden de trabajo. Si salesOrderId es nulo, es una OBRA PROPIA
// (fabricación sin cliente: stock propio, uso interno, proyecto personal).
model WorkOrder {
  pdfEmissions              WorkOrderPdfEmission[]
  completion                WorkOrderCompletion?
  invoiceIdentities         WorkOrderInvoiceIdentity[]
  invoiceReferences         WorkOrderInvoiceReference[] @relation("InvoiceHistory")
  currentInvoiceReferenceId Int?                        @unique
  currentInvoiceReference   WorkOrderInvoiceReference?  @relation("CurrentInvoice", fields: [currentInvoiceReferenceId, id], references: [id, workOrderId], onDelete: Restrict, onUpdate: NoAction)

  productionReversals ProductionReversal[]
  productionRecords   ProductionRecord[]

  reservations         StockReservationAllocation[]
  // Campos nuevos opcionales sólo para conservar trabajos legados sin inventar historia.
  schemaVersion        Int?
  folioId              Int?                         @unique
  folio                DocumentFolio?               @relation(fields: [folioId], references: [id], onDelete: Restrict)
  creationKey          String?                      @unique @db.Uuid
  version              Int                          @default(1)
  date                 DateTime?                    @db.Date
  salesOrderVersion    Int?
  sourceSnapshot       Json?
  technicalDescription Json?
  internalInstructions String?                      @db.VarChar(5000)
  ownPurpose           String?                      @db.VarChar(1000)
  targetDate           DateTime?                    @db.Date
  startedDate          DateTime?                    @db.Date
  voidedAt             DateTime?
  voidReason           String?
  lines                WorkOrderLine[]
  operations           WorkOrderOperation[]
  id                   Int                          @id @default(autoincrement())
  productName          String
  description          String?
  status               WorkOrderStatus              @default(PENDIENTE)
  salesOrderId         Int?                         @unique
  salesOrder           SalesOrder?                  @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  materialsUsed        WorkOrderDetail[]
  deliveryNotes        DeliveryNote[]

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)
  // La unicidad permite múltiples obras propias con salesOrderId = null.

  @@unique([currentInvoiceReferenceId, id])
  @@index([status, date, id])
  @@index([targetDate, id])
}

enum WorkOrderStatus {
  PENDIENTE
  EN_PROCESO
  FINALIZADO
  ANULADO
}

enum WorkOrderExecutionMode {
  CATALOGO
  VENTA_DIRECTA_MP
  SERVICIO
  A_MEDIDA
}

// Tipos iniciales; Producción/Reservas amplían el historial en sus migraciones.
enum WorkOrderOperationType {
  FINALIZAR
  REGISTRAR_FACTURA
  CORREGIR_FACTURA
  REVERTIR_PRODUCCION
  REGISTRAR_PRODUCCION
  RESERVAR_STOCK
  LIBERAR_RESERVA
  CREAR
  EDITAR_PLAN
  INICIAR
  ANULAR
}

model WorkOrderLine {
  productionRecords ProductionRecord[]

  roundingReview     Json? // Revisión expresa cuando una necesidad positiva redondea a cero.
  reservations       StockReservationAllocation[]
  id                 Int                          @id @default(autoincrement())
  workOrderId        Int
  workOrder          WorkOrder                    @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  salesOrderId       Int?
  salesOrderDetailId Int?                         @unique
  salesOrderDetail   SalesOrderDetail?            @relation(fields: [salesOrderDetailId, salesOrderId], references: [id, salesOrderId], onDelete: Restrict)
  position           Int
  kind               QuoteLineType
  executionMode      WorkOrderExecutionMode
  description        String
  code               String?
  unitMeasureId      Int
  unitMeasure        UnitMeasure                  @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  unitName           String
  unitAbbreviation   String
  productId          Int?
  product            Product?                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  rawMaterialId      Int?
  rawMaterial        RawMaterial?                 @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  quantity           Decimal                      @db.Decimal(14, 3)
  quantityToProduce  Decimal?                     @db.Decimal(14, 3)
  quantityFromStock  Decimal?                     @db.Decimal(14, 3)
  productVersion     Int?
  recipeCapturedAt   DateTime?
  recipeFingerprint  String?                      @db.VarChar(64)
  version            Int                          @default(1)
  recipeMaterials    WorkOrderRecipeMaterial[]
  materials          WorkOrderDetail[]
  supplies           WorkOrderSupplyPlan[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([id, workOrderId])
  @@unique([workOrderId, position])
  @@unique([salesOrderDetailId, salesOrderId])
  @@index([productId])
  @@index([rawMaterialId])
  @@index([unitMeasureId])
}

model WorkOrderRecipeMaterial {
  retiredAt        DateTime? // Revisión anterior conservada fuera del plan vigente.
  id               Int               @id @default(autoincrement())
  workOrderLineId  Int
  workOrderLine    WorkOrderLine     @relation(fields: [workOrderLineId], references: [id], onDelete: Restrict)
  rawMaterialId    Int
  rawMaterial      RawMaterial       @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  unitMeasureId    Int
  unitMeasure      UnitMeasure       @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  quantityPerUnit  Decimal           @db.Decimal(14, 3)
  materialCode     String
  materialName     String
  unitName         String
  unitAbbreviation String
  materials        WorkOrderDetail[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([id, workOrderLineId, rawMaterialId])
  @@unique([workOrderLineId, rawMaterialId])
  @@index([rawMaterialId])
  @@index([unitMeasureId])
}

model WorkOrderSupplyPlan {
  retiredAt       DateTime? // Revisión anterior conservada fuera del plan vigente.
  reservations    StockReservationAllocation[]
  id              Int                          @id @default(autoincrement())
  workOrderId     Int
  workOrderLineId Int
  workOrderLine   WorkOrderLine                @relation(fields: [workOrderLineId, workOrderId], references: [id, workOrderId], onDelete: Restrict)
  warehouseId     Int
  warehouse       Warehouse                    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId       Int?
  product         Product?                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  rawMaterialId   Int?
  rawMaterial     RawMaterial?                 @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  quantity        Decimal                      @db.Decimal(14, 3)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@unique([workOrderLineId, warehouseId])
  @@index([workOrderLineId, workOrderId])
  @@index([warehouseId])
  @@index([productId])
  @@index([rawMaterialId])
}

model WorkOrderOperation {
  completionId       Int?                       @unique
  completion         WorkOrderCompletion?       @relation(fields: [completionId, workOrderId], references: [id, workOrderId], onDelete: Restrict)
  invoiceReferenceId Int?                       @unique
  invoiceReference   WorkOrderInvoiceReference? @relation(fields: [invoiceReferenceId, workOrderId], references: [id, workOrderId], onDelete: Restrict)

  productionReversalId Int?                @unique
  productionReversal   ProductionReversal? @relation(fields: [productionReversalId, workOrderId], references: [id, workOrderId], onDelete: Restrict)

  productionRecordId Int?              @unique
  productionRecord   ProductionRecord? @relation(fields: [productionRecordId, workOrderId], references: [id, workOrderId], onDelete: Restrict)

  planConfirmed       Boolean? // Sólo CREAR/EDITAR_PLAN; null en historia anterior.
  reason              String?                      @db.VarChar(1000)
  reservationSnapshot Json?
  reservations        StockReservationAllocation[]
  reservationEvents   StockReservationEvent[]
  idempotencyKey      String                       @id @db.Uuid
  fingerprint         String                       @db.VarChar(64)
  workOrderId         Int
  workOrder           WorkOrder                    @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  type                WorkOrderOperationType
  version             Int
  beforeSnapshot      Json?
  afterSnapshot       Json
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@unique([completionId, workOrderId])
  @@unique([invoiceReferenceId, workOrderId])
  @@unique([workOrderId, version])
  @@unique([productionRecordId, workOrderId])
  @@unique([productionReversalId, workOrderId])
}

model WorkOrderDetail {
  productionConsumptions ProductionConsumption[]

  retiredAt        DateTime? // Revisión anterior conservada fuera del plan vigente.
  reservations     StockReservationAllocation[]
  // Requerimiento previsto; el consumo real se registrará en Producción.
  workOrderLineId  Int?
  workOrderLine    WorkOrderLine?               @relation(fields: [workOrderLineId, workOrderId], references: [id, workOrderId], onDelete: Restrict)
  recipeMaterialId Int?
  recipeMaterial   WorkOrderRecipeMaterial?     @relation(fields: [recipeMaterialId, workOrderLineId, rawMaterialId], references: [id, workOrderLineId, rawMaterialId], onDelete: Restrict)
  unitMeasureId    Int?
  unitMeasure      UnitMeasure?                 @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  materialCode     String?
  materialName     String?
  unitName         String?
  unitAbbreviation String?
  id               Int                          @id @default(autoincrement())
  quantityNeeded   Decimal                      @db.Decimal(14, 3) // Cantidad prevista; no representa un consumo confirmado
  workOrderId      Int
  rawMaterialId    Int
  warehouseId      Int // Bodega de la que se descuenta el material
  workOrder        WorkOrder                    @relation(fields: [workOrderId], references: [id])
  rawMaterial      RawMaterial                  @relation(fields: [rawMaterialId], references: [id])
  warehouse        Warehouse                    @relation(fields: [warehouseId], references: [id])
  stockMovements   StockMovement[]

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)

  @@unique([workOrderLineId, rawMaterialId, warehouseId])
  @@unique([id, workOrderLineId, rawMaterialId, warehouseId])
  @@index([workOrderId])
  @@index([rawMaterialId])
  @@index([warehouseId])
  @@index([workOrderLineId, workOrderId])
  @@index([recipeMaterialId, workOrderLineId, rawMaterialId])
  @@index([unitMeasureId])
}

model DeliveryNote {
  id                 Int           @id @default(autoincrement())
  date               DateTime      @default(now())
  // Campos heredados: se conservan para transición; la nueva cobranza usa AccountReceivable/Payment.
  paymentStatus      PaymentStatus @default(PENDIENTE)
  paymentPromiseDate DateTime?
  voucherUrl         String? // URL del comprobante de pago
  workOrderId        Int
  workOrder          WorkOrder     @relation(fields: [workOrderId], references: [id])

  createdAt DateTime @default(now()) // Fecha de registro (no se modifica)
  updatedAt DateTime @updatedAt // Última modificación (automática)

  @@index([workOrderId])
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  VENCIDO
}

// ==========================================
// 7. DATOS PROPIOS DE LA EMPRESA
// ==========================================

// Perfil único: el CHECK CompanyProfile_singleton_check de la migración SQL
// permite solamente id = 1. Sin autoincremento ni datos ficticios iniciales.
// Los datos son opcionales para configurar la empresa de forma gradual.
// Antes de emitir documentos, la aplicación deberá exigir los datos acordados.
model CompanyProfile {
  id               Int                  @id @default(1)
  legalName        String? // Razón social o nombre del emisor
  tradeName        String? // Nombre comercial
  rut              String? // Convención: sin puntos, con guion y dígito verificador en mayúscula
  businessActivity String? // Giro o actividad
  address          String?
  commune          String?
  city             String?
  email            String?
  phone            String?
  logoUrl          String? // Referencia al logo; almacenamiento por definir
  bankAccounts     CompanyBankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 8. CUENTAS POR COBRAR Y ABONOS
// ==========================================

// Importe acordado por venta, independiente de cuántos trabajos o despachos tenga.
// El saldo y los estados de pago/vencimiento se calcularán; no se almacenan duplicados.
model AccountReceivable {
  id                 Int       @id @default(autoincrement())
  salesOrderId       Int       @unique
  amount             Decimal   @db.Decimal(14, 2) // No negativo ni NaN: CHECK en la migración SQL
  issuedAt           DateTime  @default(now())
  dueDate            DateTime? @db.Date // Fecha de calendario; puede no estar pactada
  paymentPromiseDate DateTime? @db.Date // Promesa independiente del vencimiento original
  voidedAt           DateTime?
  voidReason         String? // Fecha y motivo de anulación se informan juntos: CHECK SQL

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // salesOrderId ya queda indexado por @unique.
  @@index([dueDate])
}

// Historial de abonos. Los registros anulados se conservan y no reducen el saldo.
// Control de sobrepagos, concurrencia y edición/borrado: responsabilidad del futuro módulo.
model Payment {
  id                  Int       @id @default(autoincrement())
  accountReceivableId Int
  amount              Decimal   @db.Decimal(14, 2) // Estrictamente positivo y distinto de NaN: CHECK SQL
  paidAt              DateTime  @default(now())
  method              String // Medio de pago; texto no vacío, sin catálogo cerrado por ahora
  reference           String? // Referencia externa; no se usa como clave de idempotencia
  voucherUrl          String?
  idempotencyKey      String    @unique @db.Uuid // La aplicación debe reutilizarla al reintentar; sin default
  voidedAt            DateTime?
  voidReason          String? // Fecha y motivo obligatorios juntos al anular: CHECK SQL

  accountReceivable AccountReceivable @relation(fields: [accountReceivableId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountReceivableId, voidedAt, paidAt])
}

// Tipos internos; los números del cliente y de facturas externas son independientes.
enum DocumentNumberType {
  COTIZACION
  ORDEN_COMPRA_CLIENTE
  ORDEN_TRABAJO
  GUIA_DESPACHO
}

model DocumentNumbering {
  id          Int                @id @default(autoincrement())
  type        DocumentNumberType @unique
  prefix      String             @default("") @db.VarChar(20)
  padding     Int?
  nextNumber  BigInt?
  version     Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  assignments DocumentFolio[]
}

// Registro permanente: ni anular ni eliminar un documento libera su folio.
model DocumentFolio {
  workOrder      WorkOrder?
  salesOrder     SalesOrder?
  quote          Quote?
  id             Int               @id @default(autoincrement())
  numberingId    Int
  numbering      DocumentNumbering @relation(fields: [numberingId], references: [id], onDelete: Restrict)
  number         BigInt
  prefix         String            @db.VarChar(20)
  padding        Int
  folio          String            @db.VarChar(38)
  idempotencyKey String            @unique @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([numberingId, number])
  @@unique([numberingId, folio])
}

// La baja es lógica: conservar cuentas y referencias de documentos históricos.
model CompanyBankAccount {
  salesOrders   SalesOrder[]
  id            Int            @id @default(autoincrement())
  companyId     Int            @default(1)
  company       CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankName      String         @db.VarChar(100)
  accountType   String         @db.VarChar(100)
  accountNumber String         @db.VarChar(60)
  holderName    String         @db.VarChar(150)
  holderRut     String         @db.VarChar(20)
  email         String?        @db.VarChar(254)
  isActive      Boolean        @default(true)
  isPrimary     Boolean        @default(false)
  version       Int            @default(1)
  quotes        Quote[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([companyId])
}

model Product {
  productionOutputs ProductionOutput[]

  reservations        StockReservationAllocation[]
  workOrderLines      WorkOrderLine[]
  workOrderSupplies   WorkOrderSupplyPlan[]
  id                  Int                          @id @default(autoincrement())
  code                String                       @unique @default(uuid()) @db.Uuid
  creationKey         String                       @unique @db.Uuid
  creationFingerprint String                       @db.VarChar(64)
  name                String                       @db.VarChar(150)
  description         String?
  unitMeasureId       Int
  unitMeasure         UnitMeasure                  @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  suggestedPrice      Decimal?                     @db.Decimal(14, 2)
  version             Int                          @default(1)
  deletedAt           DateTime?
  recipes             ProductRecipe[]
  images              ProductImage[]
  quoteDetails        QuoteDetail[]
  stocks              ProductWarehouseStock[]
  stockMovements      ProductStockMovement[]
  initialStocks       ProductInitialStock[]
  adjustments         ProductInventoryAdjustment[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([unitMeasureId])
}

model ProductRecipe {
  id            Int         @id @default(autoincrement())
  productId     Int
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  rawMaterialId Int
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  quantity      Decimal     @db.Decimal(14, 3)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([productId, rawMaterialId])
  @@index([rawMaterialId])
}

model ProductImage {
  id        Int       @id @default(autoincrement())
  productId Int
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fileKey   String    @unique @db.VarChar(40)
  position  Int
  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId, position])
}

// Inventario de terminado separado de materias primas. Una combinación conserva su historial.
model ProductWarehouseStock {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  productId   Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Decimal   @db.Decimal(14, 3)
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
}

// Documento inmutable de existencias anteriores: no representa una fabricación.
model ProductInitialStock {
  id               Int                          @id @default(autoincrement())
  warehouseId      Int
  productId        Int
  unitMeasureId    Int
  warehouse        Warehouse                    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product          Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitMeasure      UnitMeasure                  @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  quantity         Decimal                      @db.Decimal(14, 3)
  date             DateTime                     @db.Date
  note             String
  productCode      String                       @db.Uuid
  productName      String
  unitName         String
  unitAbbreviation String
  corrections      ProductInventoryAdjustment[] @relation("CorreccionInicialTerminado")
  movement         ProductStockMovement?
  operation        ProductInventoryOperation?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([id, productId, warehouseId])
  @@unique([warehouseId, productId])
  @@index([productId])
  @@index([unitMeasureId])
  @@index([date, id])
}

model ProductStockMovement {
  productionReversalOutputId Int?                      @unique
  productionReversalOutput   ProductionReversalOutput? @relation(fields: [productionReversalOutputId, productId, warehouseId], references: [id, productId, warehouseId], onDelete: Restrict)
  productionOutputId         Int?                      @unique
  productionOutput           ProductionOutput?         @relation(fields: [productionOutputId, productId, warehouseId], references: [id, productId, warehouseId], onDelete: Restrict)

  id             Int                         @id @default(autoincrement())
  warehouseId    Int
  productId      Int
  warehouse      Warehouse                   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product        Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  adjustmentId   Int?                        @unique
  adjustment     ProductInventoryAdjustment? @relation(fields: [adjustmentId, productId, warehouseId], references: [id, productId, warehouseId], onDelete: Restrict)
  initialStockId Int?                        @unique
  initialStock   ProductInitialStock?        @relation(fields: [initialStockId, productId, warehouseId], references: [id, productId, warehouseId], onDelete: Restrict)
  type           StockMovementType
  quantity       Decimal                     @db.Decimal(14, 3)
  date           DateTime                    @db.Date
  note           String
  createdAt      DateTime                    @default(now())

  @@unique([initialStockId, productId, warehouseId])
  @@unique([adjustmentId, productId, warehouseId])
  @@unique([productionReversalOutputId, productId, warehouseId])
  @@unique([productionOutputId, productId, warehouseId])
  @@index([warehouseId, productId, id])
  @@index([productId])
}

// La operación y su documento se confirman junto con saldo y movimiento.
model ProductInventoryOperation {
  idempotencyKey String                      @id @db.Uuid
  fingerprint    String                      @db.VarChar(64)
  adjustmentId   Int?                        @unique
  adjustment     ProductInventoryAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  initialStockId Int?                        @unique
  initialStock   ProductInitialStock?        @relation(fields: [initialStockId], references: [id], onDelete: Restrict)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
}

// Conteo físico inmutable: corrige el saldo actual y conserva el documento de origen.
model ProductInventoryAdjustment {
  id                      Int                          @id @default(autoincrement())
  productId               Int
  warehouseId             Int
  unitMeasureId           Int
  product                 Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse               Warehouse                    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  unitMeasure             UnitMeasure                  @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  previousQuantity        Decimal                      @db.Decimal(14, 3)
  finalQuantity           Decimal                      @db.Decimal(14, 3)
  quantity                Decimal                      @db.Decimal(14, 3)
  reason                  InventoryAdjustmentReason
  date                    DateTime                     @db.Date
  note                    String
  productCode             String                       @db.Uuid
  productName             String
  unitName                String
  unitAbbreviation        String
  correctedInitialStockId Int?
  correctedInitialStock   ProductInitialStock?         @relation("CorreccionInicialTerminado", fields: [correctedInitialStockId, productId, warehouseId], references: [id, productId, warehouseId], onDelete: Restrict)
  correctedAdjustmentId   Int?
  correctedAdjustment     ProductInventoryAdjustment?  @relation("CorreccionAjusteTerminado", fields: [correctedAdjustmentId, productId, warehouseId], references: [id, productId, warehouseId], onDelete: Restrict)
  corrections             ProductInventoryAdjustment[] @relation("CorreccionAjusteTerminado")
  movement                ProductStockMovement?
  operation               ProductInventoryOperation?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@unique([id, productId, warehouseId])
  @@index([warehouseId, productId, date])
  @@index([productId])
  @@index([unitMeasureId])
  @@index([correctedInitialStockId, productId, warehouseId])
  @@index([correctedAdjustmentId, productId, warehouseId])
  @@index([date, id])
}

// Porcentaje configurable por fecha de documento, no por fecha de registro.
// La copia de tasa en documentos y las reglas de edición de períodos usados se integran en Cotizaciones.
model VatRatePeriod {
  quotes    Quote[]
  id        Int       @id @default(autoincrement())
  rate      Decimal   @db.Decimal(7, 4)
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([validFrom])
}

// Las operaciones son propias de Cotizaciones; no compartir UUID con Compras.
enum QuoteDiscountMode {
  SIN_DESCUENTO
  PORCENTAJE
  MONTO
}

enum QuoteLineType {
  MATERIA_PRIMA
  PRODUCTO
  SERVICIO
}

enum QuoteOperationType {
  CREAR
  EDITAR
  APROBAR
  RECHAZAR
  ELIMINAR
  CORREGIR
}

model QuoteOperation {
  idempotencyKey String             @id @db.Uuid
  fingerprint    String             @db.Char(64)
  type           QuoteOperationType
  quoteId        Int
  quote          Quote              @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  version        Int
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([quoteId, version])
}

// Archivos de borrador y documentos: conservar versiones, nunca borrar al editar.
model QuoteImageFile {
  id          String           @id @default(uuid()) @db.Uuid
  uploadKey   String           @unique @db.Uuid
  draftKey    String           @db.Uuid
  fileKey     String           @unique
  fingerprint String           @db.Char(64)
  links       QuoteImageLink[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([draftKey])
}

model QuoteImageLink {
  id        Int            @id @default(autoincrement())
  quoteId   Int
  quote     Quote          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  imageId   String         @db.Uuid
  image     QuoteImageFile @relation(fields: [imageId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([quoteId, imageId])
  @@index([imageId])
}

// Cada emisión conserva revisión completa y PDF; descargar no regenera históricos.
model QuotePdfEmission {
  salesOrders     SalesOrder[]
  id              String            @id @db.Uuid
  quoteId         Int
  quote           Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  quoteVersion    Int
  templateVersion Int
  snapshotVersion Int
  status          QuoteStatus
  folio           String
  snapshot        Json
  fileKey         String            @unique
  fileSize        Int
  fileHash        String
  requests        QuotePdfRequest[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([quoteId, quoteVersion, templateVersion])
  @@index([quoteId, createdAt])
}

// Distintas solicitudes de una misma revisión apuntan a una única emisión.
model QuotePdfRequest {
  idempotencyKey String           @id @db.Uuid
  fingerprint    String
  emissionId     String           @db.Uuid
  emission       QuotePdfEmission @relation(fields: [emissionId], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([emissionId])
}

// Historial de reservas separado de existencias y Kardex. Nunca actualizar cantidades.
enum StockReservationPurpose {
  CONSUMO_PRODUCCION
  ENTREGA_DIRECTA_MP
  ENTREGA_PRODUCTO
}

enum StockReservationEventType {
  LIBERAR
  CONSUMIR
}

model StockReservationAllocation {
  productionOutputId Int?
  productionOutput   ProductionOutput? @relation(fields: [productionOutputId], references: [id], onDelete: Restrict)

  id               Int                     @id @default(autoincrement())
  workOrderId      Int
  workOrder        WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  workOrderLineId  Int
  workOrderLine    WorkOrderLine           @relation(fields: [workOrderLineId], references: [id], onDelete: Restrict)
  purpose          StockReservationPurpose
  warehouseId      Int
  warehouse        Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  rawMaterialId    Int?
  rawMaterial      RawMaterial?            @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  productId        Int?
  product          Product?                @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitMeasureId    Int
  unitMeasure      UnitMeasure             @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  resourceCode     String
  resourceName     String
  unitName         String
  unitAbbreviation String
  quantity         Decimal                 @db.Decimal(14, 3)
  plannedDetailId  Int?
  plannedDetail    WorkOrderDetail?        @relation(fields: [plannedDetailId], references: [id], onDelete: Restrict)
  supplyPlanId     Int?
  supplyPlan       WorkOrderSupplyPlan?    @relation(fields: [supplyPlanId], references: [id], onDelete: Restrict)
  operationId      String                  @db.Uuid
  operation        WorkOrderOperation      @relation(fields: [operationId], references: [idempotencyKey], onDelete: Restrict)
  events           StockReservationEvent[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([workOrderId, workOrderLineId, purpose])
  @@index([workOrderLineId])
  @@index([rawMaterialId, warehouseId])
  @@index([productId, warehouseId])
  @@index([warehouseId])
  @@index([unitMeasureId])
  @@index([plannedDetailId])
  @@index([supplyPlanId])
  @@index([operationId])
  @@index([productionOutputId])
}

model StockReservationEvent {
  productionConsumptionId Int?
  productionConsumption   ProductionConsumption? @relation(fields: [productionConsumptionId], references: [id], onDelete: Restrict)

  id           Int                        @id @default(autoincrement())
  allocationId Int
  allocation   StockReservationAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  type         StockReservationEventType
  quantity     Decimal                    @db.Decimal(14, 3)
  reason       String                     @db.VarChar(1000)
  operationId  String                     @db.Uuid
  operation    WorkOrderOperation         @relation(fields: [operationId], references: [idempotencyKey], onDelete: Restrict)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([allocationId])
  @@index([operationId])
  @@index([productionConsumptionId])
}

enum ProductionRecordType {
  FABRICACION_PRODUCTO
  EJECUCION_A_MEDIDA
  SERVICIO
}

// Hecho físico/avance inmutable; no es un ajuste ni un requerimiento previsto.
model ProductionRecord {
  reversal                   ProductionReversal?
  correctsProductionRecordId Int?
  correctsProductionRecord   ProductionRecord?       @relation("CorreccionProduccion", fields: [correctsProductionRecordId, workOrderLineId, workOrderId], references: [id, workOrderLineId, workOrderId], onDelete: Restrict)
  corrections                ProductionRecord[]      @relation("CorreccionProduccion")
  id                         Int                     @id @default(autoincrement())
  workOrderId                Int
  workOrder                  WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  workOrderLineId            Int
  workOrderLine              WorkOrderLine           @relation(fields: [workOrderLineId, workOrderId], references: [id, workOrderId], onDelete: Restrict)
  type                       ProductionRecordType
  date                       DateTime                @db.Date
  quantity                   Decimal                 @db.Decimal(14, 3)
  note                       String                  @db.VarChar(2000)
  deviationReason            String?                 @db.VarChar(1000)
  planVersion                Int
  expectedSnapshot           Json
  consumptions               ProductionConsumption[]
  output                     ProductionOutput?
  operation                  WorkOrderOperation?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@unique([id, workOrderId])
  @@unique([id, workOrderLineId, workOrderId])
  @@index([correctsProductionRecordId, workOrderLineId, workOrderId])
  @@index([workOrderId, date, id])
  @@index([workOrderLineId, workOrderId])
}

model ProductionConsumption {
  reversal           ProductionReversalConsumption?
  id                 Int                            @id @default(autoincrement())
  productionRecordId Int
  workOrderId        Int
  workOrderLineId    Int
  productionRecord   ProductionRecord               @relation(fields: [productionRecordId, workOrderLineId, workOrderId], references: [id, workOrderLineId, workOrderId], onDelete: Restrict)
  plannedDetailId    Int?
  plannedDetail      WorkOrderDetail?               @relation(fields: [plannedDetailId, workOrderLineId, rawMaterialId, warehouseId], references: [id, workOrderLineId, rawMaterialId, warehouseId], onDelete: Restrict)
  rawMaterialId      Int
  rawMaterial        RawMaterial                    @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  warehouseId        Int
  warehouse          Warehouse                      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  unitMeasureId      Int
  unitMeasure        UnitMeasure                    @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  quantity           Decimal                        @db.Decimal(14, 3)
  expectedQuantity   Decimal                        @db.Decimal(14, 3)
  materialCode       String
  materialName       String
  unitName           String
  unitAbbreviation   String
  movement           StockMovement?
  reservationEvents  StockReservationEvent[]
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@unique([id, rawMaterialId, warehouseId])
  @@unique([productionRecordId, rawMaterialId, warehouseId])
  @@index([productionRecordId, workOrderLineId, workOrderId])
  @@index([plannedDetailId, workOrderLineId, rawMaterialId, warehouseId])
  @@index([workOrderLineId, rawMaterialId, warehouseId])
  @@index([rawMaterialId, warehouseId, id])
  @@index([warehouseId])
  @@index([unitMeasureId])
}

model ProductionOutput {
  reversal           ProductionReversalOutput?
  id                 Int                          @id @default(autoincrement())
  productionRecordId Int                          @unique
  workOrderId        Int
  workOrderLineId    Int
  productionRecord   ProductionRecord             @relation(fields: [productionRecordId, workOrderLineId, workOrderId], references: [id, workOrderLineId, workOrderId], onDelete: Restrict)
  productId          Int
  product            Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId        Int
  warehouse          Warehouse                    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  unitMeasureId      Int
  unitMeasure        UnitMeasure                  @relation(fields: [unitMeasureId], references: [id], onDelete: Restrict)
  quantity           Decimal                      @db.Decimal(14, 3)
  productCode        String                       @db.Uuid
  productName        String
  unitName           String
  unitAbbreviation   String
  movement           ProductStockMovement?
  reservations       StockReservationAllocation[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([id, productId, warehouseId])
  @@unique([productionRecordId, workOrderLineId, workOrderId])
  @@index([productionRecordId, workOrderLineId, workOrderId])
  @@index([workOrderLineId, workOrderId])
  @@index([productId, warehouseId, id])
  @@index([warehouseId])
  @@index([unitMeasureId])
  @@index([workOrderId, id])
}

// Corrección completa e inmutable de un error de registro; no representa daño físico.
model ProductionReversal {
  id                           Int                             @id @default(autoincrement())
  productionRecordId           Int                             @unique
  workOrderId                  Int
  workOrderLineId              Int
  productionRecord             ProductionRecord                @relation(fields: [productionRecordId, workOrderLineId, workOrderId], references: [id, workOrderLineId, workOrderId], onDelete: Restrict)
  workOrder                    WorkOrder                       @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  date                         DateTime                        @db.Date
  reason                       String                          @db.VarChar(1000)
  physicalRestitutionConfirmed Boolean
  planVersion                  Int
  consumptions                 ProductionReversalConsumption[]
  output                       ProductionReversalOutput?
  operation                    WorkOrderOperation?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  @@unique([productionRecordId, workOrderLineId, workOrderId])
  @@unique([id, workOrderId])
  @@unique([id, productionRecordId])
  @@index([productionRecordId, workOrderLineId, workOrderId])
  @@index([workOrderId, date, id])
}

model ProductionReversalConsumption {
  id                      Int                   @id @default(autoincrement())
  productionReversalId    Int
  productionRecordId      Int
  productionReversal      ProductionReversal    @relation(fields: [productionReversalId, productionRecordId], references: [id, productionRecordId], onDelete: Restrict)
  productionConsumptionId Int                   @unique
  productionConsumption   ProductionConsumption @relation(fields: [productionConsumptionId, rawMaterialId, warehouseId], references: [id, rawMaterialId, warehouseId], onDelete: Restrict)
  rawMaterialId           Int
  warehouseId             Int
  unitMeasureId           Int
  quantity                Decimal               @db.Decimal(14, 3)
  materialCode            String
  materialName            String
  unitName                String
  unitAbbreviation        String
  movement                StockMovement?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([id, rawMaterialId, warehouseId])
  @@unique([productionConsumptionId, rawMaterialId, warehouseId])
  @@index([productionReversalId, productionRecordId])
}

model ProductionReversalOutput {
  id                   Int                   @id @default(autoincrement())
  productionReversalId Int                   @unique
  productionRecordId   Int
  productionReversal   ProductionReversal    @relation(fields: [productionReversalId, productionRecordId], references: [id, productionRecordId], onDelete: Restrict)
  productionOutputId   Int                   @unique
  productionOutput     ProductionOutput      @relation(fields: [productionOutputId, productId, warehouseId], references: [id, productId, warehouseId], onDelete: Restrict)
  productId            Int
  warehouseId          Int
  unitMeasureId        Int
  quantity             Decimal               @db.Decimal(14, 3)
  productCode          String                @db.Uuid
  productName          String
  unitName             String
  unitAbbreviation     String
  movement             ProductStockMovement?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([id, productId, warehouseId])
  @@unique([productionReversalId, productionRecordId])
  @@unique([productionOutputId, productId, warehouseId])
}

// Cierre industrial inmutable; no acredita despacho ni pago.
model WorkOrderCompletion {
  id                   Int                 @id @default(autoincrement())
  workOrderId          Int                 @unique
  workOrder            WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  date                 DateTime            @db.Date
  note                 String              @db.VarChar(1000)
  preparationConfirmed Boolean
  progressSnapshot     Json
  operation            WorkOrderOperation?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([id, workOrderId])
}

// Identidad permanente: corregir una referencia nunca libera el folio anterior.
model WorkOrderInvoiceIdentity {
  id            Int                         @id @default(autoincrement())
  workOrderId   Int
  workOrder     WorkOrder                   @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  issuerRut     String                      @db.VarChar(12)
  invoiceNumber String                      @db.VarChar(150)
  references    WorkOrderInvoiceReference[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@unique([issuerRut, invoiceNumber])
  @@unique([id, workOrderId])
  @@index([workOrderId])
}

model WorkOrderInvoiceReference {
  id                         Int                        @id @default(autoincrement())
  workOrderId                Int
  workOrder                  WorkOrder                  @relation("InvoiceHistory", fields: [workOrderId], references: [id], onDelete: Restrict)
  identityId                 Int
  identity                   WorkOrderInvoiceIdentity   @relation(fields: [identityId, workOrderId], references: [id, workOrderId], onDelete: Restrict)
  revision                   Int
  issuerRut                  String                     @db.VarChar(12)
  invoiceNumber              String                     @db.VarChar(150)
  invoiceDate                DateTime                   @db.Date
  paymentTermDays            Int
  dueDate                    DateTime                   @db.Date
  replacesInvoiceReferenceId Int?                       @unique
  replaces                   WorkOrderInvoiceReference? @relation("InvoiceReplacement", fields: [replacesInvoiceReferenceId, workOrderId], references: [id, workOrderId], onDelete: Restrict, onUpdate: NoAction)
  replacedBy                 WorkOrderInvoiceReference? @relation("InvoiceReplacement")
  correctionReason           String?                    @db.VarChar(1000)
  currentFor                 WorkOrder?                 @relation("CurrentInvoice")
  operation                  WorkOrderOperation?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  @@unique([replacesInvoiceReferenceId, workOrderId])
  @@unique([id, workOrderId])
  @@unique([workOrderId, revision])
  @@index([identityId, workOrderId])
}

// Emisiones históricas de OT: no cambian revisión, folio ni inventarios.
model WorkOrderPdfEmission {
  id               String                @id @db.Uuid
  workOrderId      Int
  workOrder        WorkOrder             @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  workOrderVersion Int
  templateVersion  Int
  snapshotVersion  Int
  status           WorkOrderStatus
  folio            String
  snapshot         Json
  fileKey          String                @unique
  fileSize         Int
  fileHash         String
  requests         WorkOrderPdfRequest[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([workOrderId, workOrderVersion, templateVersion])
  @@index([workOrderId, createdAt])
}

// Distintas solicitudes de una misma revisión apuntan a una única emisión.
model WorkOrderPdfRequest {
  idempotencyKey String               @id @db.Uuid
  fingerprint    String
  emissionId     String               @db.Uuid
  emission       WorkOrderPdfEmission @relation(fields: [emissionId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([emissionId])
}
